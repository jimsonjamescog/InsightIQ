INSIGHTIQ_AGENT_MODE=openai
INSIGHTIQ_OPENAI_MODEL=gpt-4.1-mini
INSIGHTIQ_MAX_STEPS=15
INSIGHTIQ_MAX_TOOL_CALLS=12
INSIGHTIQ_CONFIDENCE_THRESHOLD=0.75
INSIGHTIQ_DATA_BACKEND=duckdb
INSIGHTIQ_DATABASE_PATH=data/insightiq.duckdb
INSIGHTIQ_AUTO_BOOTSTRAP_DATA=true
OPENAI_API_KEY=

# Required only when INSIGHTIQ_DATA_BACKEND=snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=INSIGHTIQ
SNOWFLAKE_ROLE=
SNOWFLAKE_AUTHENTICATOR=
